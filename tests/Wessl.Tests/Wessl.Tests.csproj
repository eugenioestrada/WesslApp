<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wessl.Domain\Wessl.Domain.csproj" />
    <ProjectReference Include="..\..\src\Wessl.Infrastructure\Wessl.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Wessl.App\Services\ContainerService.cs" Link="ContainerService.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\ContainerLogsSession.cs" Link="ContainerLogsSession.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\ImageService.cs" Link="ImageService.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\ContainerPolling.cs" Link="ContainerPolling.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\ContainerListQuery.cs" Link="ContainerListQuery.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\ServiceRegistration.cs" Link="ServiceRegistration.cs" />
    <Compile Include="..\..\src\Wessl.App\Services\AppSettings.cs" Link="AppSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Wessl.App\Strings\**\Resources.resw">
      <Link>Strings\%(RecursiveDir)Resources.resw</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>